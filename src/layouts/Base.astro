---
import '@fontsource/anton/400.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/montserrat/800.css';
import '../styles/global.css';
import { SITE } from '../site';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
  /** Link-preview image under public/, 1200×630 (see scripts/make-brand.py) */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  /** Extra schema.org objects for this page */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image = '/og/default.jpg',
  imageAlt,
  type = 'website',
  published,
  jsonLd = [],
} = Astro.props;
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${Astro.site}#org`,
  name: SITE.name,
  url: Astro.site!.href,
  logo: new URL('/icon-512.png', Astro.site).href,
  description: SITE.tagline,
  sameAs: [SITE.instagram, SITE.youtube],
};
const schema = [org, ...jsonLd];
const nav = [
  { href: '/log/', label: 'Tapes' },
  { href: '/spotted/', label: 'Spotted' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0a" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — new tapes`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? fullTitle} />
    <meta property="og:locale" content="en_IN" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt ?? fullTitle} />

    <script type="application/ld+json" set:html={JSON.stringify(schema.length === 1 ? schema[0] : schema)} />
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="logo" href="/" aria-label="Pushit TV home">
          <Logo />
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="display display--xl site-footer__sign">Checkit.<br /><span>Pushit.</span></p>
        <div class="site-footer__row">
          <p class="kicker">{SITE.tagline} <b>All-India Propaganda.</b></p>
          <ul>
            <li><a href={SITE.instagram} rel="me noopener">Instagram</a></li>
            <li><a href={SITE.youtube} rel="me noopener">YouTube</a></li>
            <li><a href="/work/#contact">Get filmed</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script>
      // Header loops: play while on screen, pause when off. Respect reduced motion.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const io = new IntersectionObserver(
        (entries) => {
          for (const { target, isIntersecting } of entries) {
            const v = target as HTMLVideoElement;
            if (isIntersecting) v.play().catch(() => {});
            else v.pause();
          }
        },
        { threshold: 0.25 },
      );
      if (!reduced) {
        document.querySelectorAll<HTMLVideoElement>('video[data-loop]').forEach((v) => {
          v.preload = 'auto';
          io.observe(v);
        });
      }

      // YouTube: swap the poster for the player on demand; chapter buttons seek.
      const load = (player: HTMLElement, start = 0) => {
        const id = player.dataset.yt!;
        const frame = document.createElement('iframe');
        frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&start=${start}`;
        frame.title = player.dataset.title ?? 'YouTube video';
        frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        frame.allowFullscreen = true;
        player.replaceChildren(frame);
        player.classList.add('is-playing');
      };
      document.querySelectorAll<HTMLElement>('[data-yt]').forEach((player) => {
        player.querySelector('a')?.addEventListener('click', (e) => {
          e.preventDefault();
          load(player);
        });
      });
      document.querySelectorAll<HTMLAnchorElement>('[data-seek]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const player = document.querySelector<HTMLElement>(`[data-yt="${a.dataset.video}"]`);
          if (!player) return;
          e.preventDefault();
          load(player, Number(a.dataset.seek));
          player.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
        });
      });
    </script>

    <style>
      .skip:focus {
        position: fixed;
        top: 1rem;
        left: 1rem;
        width: auto;
        height: auto;
        clip: auto;
        z-index: 200;
        background: var(--red);
        color: var(--bg);
        padding: 0.6rem 1rem;
      }
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgb(11 11 10 / 0.88);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--rule);
        padding-top: env(safe-area-inset-top, 0px);
      }
      .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 3.75rem;
      }
      .logo {
        display: block;
        padding-block: 0.55rem 0.35rem;
        text-decoration: none;
      }
      .logo:hover :global(.logo-mark__word) { background: var(--red); }
      nav ul {
        display: flex;
        gap: clamp(0.9rem, 2.5vw, 2rem);
        list-style: none;
        margin: 0;
        padding: 0;
      }
      nav a {
        font: 500 0.75rem/1 var(--mono);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        text-decoration: none;
        padding-block: 0.5rem;
      }
      nav a[aria-current='page'] { color: var(--red); }

      .site-footer {
        margin-top: clamp(5rem, 12vw, 9rem);
        border-top: 1px solid var(--fg);
        padding-block: clamp(2.5rem, 6vw, 4rem) calc(2rem + env(safe-area-inset-bottom, 0px));
      }
      .site-footer__sign span { color: var(--red); }
      .site-footer__row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-top: 2.5rem;
      }
      .site-footer ul {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font: 500 0.8rem/1 var(--mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .site-footer a { text-decoration: none; }

      @media (max-width: 30rem) {
        .logo { font-size: 0.85rem; }
        nav ul { gap: 0.8rem; }
        nav a { font-size: 0.68rem; letter-spacing: 0.08em; }
      }
    </style>
  </body>
</html>
