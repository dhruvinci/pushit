---
// Poster-first YouTube player: nothing from YouTube loads until someone presses play.
import { ytThumb, clock, seconds } from '../lib/episodes';

interface Props {
  id: string;
  title: string;
  duration?: number;
  chapters?: { t: string; label: string }[];
}
const { id, title, duration, chapters = [] } = Astro.props;
---

<div class="yt">
  <div class="yt__player" data-yt={id} data-title={title}>
    <a href={`https://www.youtube.com/watch?v=${id}`} aria-label={`Play ${title}`}>
      <img src={ytThumb(id)} alt="" loading="lazy" decoding="async" />
      <span class="yt__play" aria-hidden="true">▶ Play</span>
    </a>
  </div>
  <div class="yt__meta">
    <p class="kicker"><b>{title}</b>{duration ? ` · ${clock(duration)}` : ''}</p>
    {
      chapters.length > 0 && (
        <ol class="yt__chapters">
          {chapters.map((c) => (
            <li>
              <a
                href={`https://www.youtube.com/watch?v=${id}&t=${seconds(c.t)}s`}
                data-seek={seconds(c.t)}
                data-video={id}
              >
                <span class="stamp">{c.t}</span> {c.label}
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</div>

<style>
  .yt { margin-bottom: 2.5rem; }
  .yt__player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
  }
  .yt__player a { display: block; height: 100%; }
  .yt__player img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.25) contrast(1.05);
    transition: filter 0.2s, transform 0.4s;
  }
  .yt__player a:hover img { filter: none; transform: scale(1.015); }
  .yt__play {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    font: 500 0.8rem/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--red);
    color: var(--bg);
    padding: 0.9em 1.2em;
  }
  .yt__player :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .yt__meta { padding-top: 0.8rem; }
  .yt__chapters {
    list-style: none;
    margin: 0.8rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .yt__chapters a {
    display: inline-block;
    font-size: 0.78rem;
    padding: 0.45em 0.7em;
    border: 1px solid var(--rule);
    text-decoration: none;
  }
  .yt__chapters a:hover { border-color: var(--red); color: var(--fg); }
</style>
