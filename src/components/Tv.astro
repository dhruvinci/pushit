---
// Pushit TV, the channel: every YouTube video on the site, shuffled, airing around the clock on the homepage.
// The schedule (src/lib/schedule.ts) is worked out from the clock, so every visitor sees the same show.
//
// It's a TV, not a player: it opens as a muted live feed, like a set left on in a bar, and the only
// controls are sound on/off and Watch on YouTube. No pause, no seeking; it stays on schedule.
// (Autoplayed embeds don't count as YouTube views. That's the trade for staying immersive.)
// Without JS: the current show's poster, linking to YouTube.
import { getCollection } from 'astro:content';
import { getEpisodes, SERIES, ytThumb, clock } from '../lib/episodes';
import { schedule, type Show } from '../lib/schedule';

const episodes = await getEpisodes();
const artists = new Map((await getCollection('spotted')).map((s) => [s.id, s.data.name]));
const roster: Show[] = [
  ...episodes.flatMap((ep) =>
    ep.data.youtube.map((v) => ({
      id: v.id,
      duration: v.duration,
      subject: ep.data.subject,
      title: v.title,
      label: SERIES[ep.data.series].label,
      href: `/tapes/${ep.id}/`,
      tape: ep.tape,
    })),
  ),
  ...(await getCollection('work')).map((w) => ({
    id: w.data.youtube,
    duration: w.data.duration,
    subject: artists.get(w.data.artist.id) ?? w.data.artist.id,
    title: w.data.title,
    label: w.data.kind,
    href: '/work/',
  })),
];
const tv = schedule(roster);
// What's on at build time: only seen without JS, which then shows it as a poster.
const [now, ...next] = tv.at(Date.now() / 1000, 3);
const watch = (id: string) => `https://www.youtube.com/watch?v=${id}`;
---

<section class="tv" data-tv data-roster={JSON.stringify(roster)} aria-label="Pushit TV, on air">
  <div class="tv__set">
    <div class="tv__screen">
      <div class="tv__frame"><div class="tv__mount"></div></div>
      <img class="tv__poster" src={ytThumb(now.show.id)} alt="" width="1280" height="720" fetchpriority="high" />
      <a class="tv__nojs" href={watch(now.show.id)}>▶ Watch on YouTube</a>
      <div class="tv__hud" aria-hidden="true">
        <span class="tv__onair"><i></i>On air</span>
        <span class="tv__clock"></span>
      </div>
      <button class="tv__tap" type="button" aria-label="Turn sound on" hidden><span>Tap for sound</span></button>

      <!-- full screen only: a control bar that sleeps, and the Up next drawer (right edge, or bottom when tall) -->
      <div class="tv__edge" aria-hidden="true"></div>
      <div class="tv__chrome">
        <button class="tv__btn tv__icon tv__sound" type="button" aria-pressed="false" aria-label="Sound off" title="Sound off">
          <svg class="tv__sound-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"></path><path d="M16.5 9.5l5 5m0-5l-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path></svg>
          <svg class="tv__sound-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"></path><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
        </button>
        <span class="tv__chrome-now"></span>
        <button class="tv__btn tv__drawer-btn" type="button" aria-expanded="false">Up next</button>
        <button class="tv__btn tv__icon tv__fs-exit" type="button" aria-label="Exit full screen" title="Exit full screen">
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 2v5H2M18 7h-5V2M13 18v-5h5M2 13h5v5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
        </button>
      </div>
      <aside class="tv__drawer" aria-label="Up next">
        <p class="kicker"><span class="rec">Now playing</span></p>
        <p class="tv__drawer-now"><b></b> <span></span></p>
        <p class="kicker tv__drawer-head">Up next</p>
        <ol class="tv__next tv__drawer-list"></ol>
      </aside>
    </div>
    <p class="tv__status" hidden>
      <button class="tv__btn tv__icon tv__sound" type="button" aria-pressed="false" aria-label="Sound off" title="Sound off">
          <svg class="tv__sound-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"></path><path d="M16.5 9.5l5 5m0-5l-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"></path></svg>
          <svg class="tv__sound-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"></path><path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
        </button>
      <button class="tv__btn tv__icon tv__fs" type="button" aria-label="Full screen" title="Full screen">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2 7V2h5M13 2h5v5M18 13v5h-5M7 18H2v-5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
      </button>
      <a class="tv__yt" href={watch(now.show.id)} rel="noopener" aria-label="Watch on YouTube" title="Watch on YouTube">
        <svg viewBox="0 0 24 17" aria-hidden="true"><rect width="24" height="17" rx="4" fill="currentColor"></rect><path d="M9.6 4.8v7.4l6.2-3.7z" fill="var(--bg-2)"></path></svg>
      </a>
    </p>
  </div>

  <div class="tv__guide">
    <p class="kicker tv__kicker"><span class="rec">Now playing</span> <span class="tv__label">{now.show.label}</span></p>
    <div aria-live="polite">
      <p class="display tv__subject">{now.show.subject}</p>
      <p class="headline tv__title">{now.show.title}</p>
    </div>
    <div class="tv__progress" aria-hidden="true"><span></span></div>
    <p class="tv__times"><span class="tv__elapsed"></span> <span class="tv__dur">{clock(now.show.duration)}</span></p>

    <h2 class="kicker tv__next-head">Up next</h2>
    <ol class="tv__next">
      {
        next.map((slot) => (
          <li>
            <time class="stamp" />
            <span class="tv__next-show">
              <b>{slot.show.subject}</b> {slot.show.title}
            </span>
            <span class="tv__next-dur">{clock(slot.show.duration)}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import { loadYouTube, PLAYING, PAUSED, BUFFERING, CUED, ENDED } from '../lib/youtube';
  import { schedule, type Show, type Slot } from '../lib/schedule';

  const DRIFT = 6; // seconds off schedule before we jump back to the live point

  const pad = (n: number) => String(n).padStart(2, '0');
  const fmt = (s: number) => {
    s = Math.max(0, Math.floor(s));
    const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
    return h ? `${h}:${pad(m)}:${pad(s % 60)}` : `${m}:${pad(s % 60)}`;
  };
  const hhmm = (t: number) => new Date(t * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  const hhmmss = (t: number) =>
    new Date(t * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  const watch = (id: string) => `https://www.youtube.com/watch?v=${id}`;

  for (const root of document.querySelectorAll<HTMLElement>('[data-tv]')) setup(root);

  function setup(root: HTMLElement) {
    const tv = schedule(JSON.parse(root.dataset.roster!));
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as T;
    const poster = $<HTMLImageElement>('.tv__poster'), tap = $<HTMLButtonElement>('.tv__tap');
    const status = $('.tv__status'), yt = $<HTMLAnchorElement>('.tv__yt');
    const soundBtns = root.querySelectorAll<HTMLButtonElement>('.tv__sound');
    const screenEl = $('.tv__screen'), fsBtn = $<HTMLButtonElement>('.tv__fs'), fsExit = $<HTMLButtonElement>('.tv__fs-exit');
    const drawerBtn = $<HTMLButtonElement>('.tv__drawer-btn'), drawer = $('.tv__drawer'), edge = $('.tv__edge');
    const chromeNow = $('.tv__chrome-now'), drawerNow = $('.tv__drawer-now'), drawerList = $('.tv__drawer-list');
    const clockEl = $('.tv__clock'), label = $('.tv__label'), subject = $('.tv__subject'), title = $('.tv__title');
    const bar = $('.tv__progress span'), elapsed = $('.tv__elapsed'), dur = $('.tv__dur');
    const nextList = $('.tv__next');
    const thumb = (show: Show) => poster.src.replace(/[^/]+\.jpg$/, `${show.id}.jpg`);

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = (navigator as any).connection?.saveData === true;
    const now = () => Date.now() / 1000;

    let player: any, loaded = '', state = -1, settled = -1, muted = true, visible = true, shown = '';
    // On phones YouTube flashes its own controls (a big pause button) for a few seconds whenever a video
    // starts or ends, even with controls=0, and we can't reach into its frame. So the show's still covers
    // the last couple of seconds and the first few of every show, like a TV cutting over.
    const touch = matchMedia('(pointer: coarse)').matches;
    let curtain: number | undefined;
    // Off until the browser lets it play: straight away normally; after a tap when autoplay is refused,
    // or for reduced motion / data saver, where the first tap switches it on with sound.
    let on = !reduced && !saveData;

    root.classList.add('has-js');
    status.hidden = false;
    tap.hidden = false;

    const setSound = (sound: boolean) => {
      muted = !sound;
      if (player?.mute) {
        if (sound) (player.unMute(), player.setVolume(100));
        else player.mute();
      }
      for (const b of soundBtns) {
        b.setAttribute('aria-pressed', String(sound));
        b.ariaLabel = b.title = sound ? 'Sound on' : 'Sound off';
      }
      tap.setAttribute('aria-label', sound ? 'Turn sound off' : 'Turn sound on');
      root.classList.toggle('is-muted', muted);
      if (sound) document.dispatchEvent(new CustomEvent('pushit:play', { detail: root }));
    };

    // --- the guide: now playing, up next, the clock
    const rows = (slots: Slot[]) =>
      slots.map((slot) => {
        const li = document.createElement('li');
        const time = document.createElement('time');
        time.className = 'stamp';
        time.dateTime = new Date(slot.start * 1000).toISOString();
        time.textContent = hhmm(slot.start);
        const name = document.createElement('span');
        name.className = 'tv__next-show';
        const b = document.createElement('b');
        b.textContent = slot.show.subject;
        name.append(b, ` ${slot.show.title}`);
        const d = document.createElement('span');
        d.className = 'tv__next-dur';
        d.textContent = fmt(slot.show.duration);
        li.append(time, name, d);
        return li;
      });

    const guide = (): Slot => {
      const t = now();
      const [cur, ...upcoming] = tv.at(t, 5);
      if (cur.show.id !== shown) {
        shown = cur.show.id;
        label.textContent = cur.show.label;
        subject.textContent = cur.show.subject;
        title.textContent = cur.show.title;
        dur.textContent = fmt(cur.show.duration);
        yt.href = watch(cur.show.id);
        poster.src = thumb(cur.show);
        chromeNow.textContent = `${cur.show.subject} — ${cur.show.title}`;
        drawerNow.querySelector('b')!.textContent = cur.show.subject;
        drawerNow.querySelector('span')!.textContent = cur.show.title;
        nextList.replaceChildren(...rows(upcoming.slice(0, 3)));
        drawerList.replaceChildren(...rows(upcoming));
      }
      bar.style.width = `${(cur.offset / cur.show.duration) * 100}%`;
      elapsed.textContent = `${fmt(cur.offset)} /`;
      clockEl.textContent = hhmmss(t);
      return cur;
    };

    // --- keep the picture on schedule
    const sync = (cur: Slot) => {
      if (touch && cur.end - now() < 2.5) root.classList.add('is-curtain');
      if (!player?.getPlayerState || !on) return;
      if (muted && !visible) return; // nobody watching or listening: rest
      if (cur.show.id !== loaded) {
        player.loadVideoById({ videoId: cur.show.id, startSeconds: cur.offset });
        loaded = cur.show.id;
      } else if (state === PLAYING) {
        if (Math.abs(player.getCurrentTime() - cur.offset) > DRIFT) player.seekTo(cur.offset, true);
      } else if (state === PAUSED || state === CUED || state === -1) {
        player.seekTo(cur.offset, true);
        player.playVideo();
      }
      // ENDED: our timing ran a second long; the next show loads when its slot starts.
    };

    const onState = (e: { data: number }) => {
      state = e.data;
      root.classList.toggle('is-playing', state === PLAYING || state === BUFFERING);
      if (state === PLAYING && settled !== PLAYING && touch) {
        root.classList.add('is-curtain');
        clearTimeout(curtain);
        curtain = window.setTimeout(() => root.classList.remove('is-curtain'), 4000);
      }
      if (state !== BUFFERING) settled = state;
      if (state === ENDED && touch) root.classList.add('is-curtain');
      if (state === PLAYING) {
        root.classList.add('is-on');
        root.classList.remove('is-off');
        sync(guide()); // back from a rest: jump to the live point
      }
    };

    // Autoplay refused (iOS low power mode, browser policy): wait for a tap to switch the set on.
    const refused = () => {
      if (root.classList.contains('is-on')) return;
      on = false;
      root.classList.add('is-off');
    };

    loadYouTube().then((YT) => {
      const cur = guide();
      loaded = cur.show.id;
      player = new YT.Player($('.tv__mount'), {
        host: 'https://www.youtube-nocookie.com',
        videoId: cur.show.id,
        playerVars: {
          autoplay: on ? 1 : 0, mute: 1, controls: 0, disablekb: 1, fs: 0, rel: 0, iv_load_policy: 3,
          playsinline: 1, cc_load_policy: 0, start: Math.floor(cur.offset), origin: location.origin,
        },
        events: {
          onReady: () => {
            if (muted) player.mute();
            if (on) player.playVideo();
          },
          onStateChange: onState,
          onAutoplayBlocked: refused,
        },
      });
      if (on) setTimeout(refused, 5000);
      else root.classList.add('is-off');
    });

    // The whole screen is the sound switch. When the set is off, the first tap turns it on, with sound.
    const toggle = () => {
      if (!on) {
        on = true;
        setSound(true);
        if (player?.playVideo) {
          const cur = guide();
          if (cur.show.id !== loaded) (player.loadVideoById({ videoId: cur.show.id, startSeconds: cur.offset }), (loaded = cur.show.id));
          else (player.seekTo(cur.offset, true), player.playVideo());
        }
        return;
      }
      setSound(muted);
    };
    // In full screen a tap on the picture wakes the controls (or puts them, and the drawer, away), like
    // YouTube on a phone. A mouse wakes them just by moving, so its click stays the sound switch.
    let pointer = 'mouse';
    tap.addEventListener('pointerdown', (e) => (pointer = e.pointerType));
    tap.addEventListener('click', () => {
      if (!fs || !on || pointer === 'mouse') return toggle();
      if (drawerOpen) return setDrawer(false);
      screenEl.classList.contains('is-awake') ? sleep() : wake();
    });
    for (const b of soundBtns) b.addEventListener('click', toggle);

    // --- full screen. The screen itself goes full screen, landscape on phones like YouTube: Android locks
    // the orientation; iPhone Safari can't full-screen a page element or lock orientation, so there the
    // screen covers the window instead, turned on its side while the phone is upright.
    let fs = false, drawerOpen = false, sleepTimer: number | undefined;
    const native = !!(screenEl.requestFullscreen || (screenEl as any).webkitRequestFullscreen);
    const fsElement = () => document.fullscreenElement ?? (document as any).webkitFullscreenElement;

    const wake = () => {
      if (!fs) return;
      screenEl.classList.add('is-awake');
      clearTimeout(sleepTimer);
      sleepTimer = window.setTimeout(() => !drawerOpen && sleep(), 3000);
    };
    const sleep = () => {
      clearTimeout(sleepTimer);
      screenEl.classList.remove('is-awake');
    };
    const setDrawer = (open: boolean) => {
      drawerOpen = open && fs;
      screenEl.classList.toggle('is-drawer', drawerOpen);
      drawerBtn.setAttribute('aria-expanded', String(drawerOpen));
      if (drawerOpen) (screenEl.classList.add('is-awake'), clearTimeout(sleepTimer));
      else wake();
    };
    const rotate = () =>
      screenEl.classList.toggle('is-rotated', fs && !fsElement() && innerHeight > innerWidth && touch);

    const setFs = (onFs: boolean) => {
      fs = onFs;
      screenEl.classList.toggle('is-fs', fs);
      document.documentElement.classList.toggle('tv-locked', fs && !fsElement());
      rotate();
      if (fs) wake();
      else (setDrawer(false), sleep());
    };
    const enterFs = async () => {
      if (native) {
        try {
          await (screenEl.requestFullscreen?.({ navigationUI: 'hide' }) ?? (screenEl as any).webkitRequestFullscreen());
          if (touch) await (screen.orientation as any)?.lock?.('landscape').catch(() => {});
          return;
        } catch {} // refused: fall back to covering the window
      }
      setFs(true);
    };
    const exitFs = () => {
      if (fsElement()) (document.exitFullscreen?.() ?? (document as any).webkitExitFullscreen?.());
      else setFs(false);
    };
    fsBtn.addEventListener('click', enterFs);
    fsExit.addEventListener('click', exitFs);
    drawerBtn.addEventListener('click', () => setDrawer(!drawerOpen));
    const onFsChange = () => {
      const el = fsElement();
      if (el === screenEl) setFs(true);
      else if (fs && !el) {
        (screen.orientation as any)?.unlock?.();
        setFs(false);
      }
    };
    document.addEventListener('fullscreenchange', onFsChange);
    document.addEventListener('webkitfullscreenchange', onFsChange);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && fs && !fsElement()) exitFs();
    });
    addEventListener('resize', rotate);
    // Mouse: moving wakes the controls; resting on the drawer's edge slides it out.
    screenEl.addEventListener('pointermove', (e) => e.pointerType === 'mouse' && wake());
    edge.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && setDrawer(true));
    drawer.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && setDrawer(false));

    // Something else started playing with sound: the TV goes quiet but stays on.
    document.addEventListener('pushit:play', (e) => {
      if ((e as CustomEvent).detail !== root && !muted) setSound(false);
    });

    // A muted set rests when nobody can see it and picks up the live point on return.
    const rest = () => {
      if (muted && !visible && player?.pauseVideo && (state === PLAYING || state === BUFFERING)) player.pauseVideo();
    };
    let onScreen = true;
    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        visible = onScreen && !document.hidden;
        rest();
      },
      { threshold: 0.2 },
    ).observe($('.tv__screen'));
    document.addEventListener('visibilitychange', () => {
      visible = onScreen && !document.hidden;
      rest();
    });

    setSound(false);
    guide();
    setInterval(() => sync(guide()), 1000);
  }
</script>

<style>
  .tv {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: start;
  }

  /* screen */
  .tv__screen {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: hidden;
    border: 1px solid var(--rule);
  }
  .tv__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  /* Cropped like the tape player: twice as tall and centred, so YouTube's title bar and branding sit
     out of frame. It never takes clicks; the screen is our sound switch. */
  .tv__frame :global(iframe) {
    position: absolute;
    left: 0;
    top: -50%;
    width: 100%;
    height: 200%;
    border: 0;
    pointer-events: none;
  }
  .tv__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }
  .tv.is-on:not(.is-curtain) .tv__poster { opacity: 0; }
  .tv__nojs {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    font: 500 0.8rem/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--red);
    color: var(--bg);
    padding: 0.9em 1.2em;
    text-decoration: none;
  }
  .tv.has-js .tv__nojs { display: none; }

  .tv__hud {
    position: absolute;
    inset: 0.9rem 1rem auto;
    display: flex;
    justify-content: space-between;
    font: 500 0.75rem/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg);
    text-shadow: 0 1px 3px #000;
    pointer-events: none;
    z-index: 2;
  }
  .tv__onair { display: inline-flex; align-items: center; gap: 0.45em; }
  .tv__onair i {
    width: 0.62em;
    height: 0.62em;
    border-radius: 50%;
    background: var(--red);
  }
  .tv.is-playing .tv__onair i { animation: blink 1.4s steps(2, jump-none) infinite; }
  .tv__clock { font-variant-numeric: tabular-nums; }

  .tv__tap {
    position: absolute;
    inset: 0;
    width: 100%;
    z-index: 3;
    background: transparent;
    border: 0;
    cursor: pointer;
    display: flex;
    align-items: end;
    justify-content: end;
    padding: 1rem;
  }
  .tv__tap span {
    font: 500 0.72rem/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg);
    padding: 0.8em 1em;
    background: rgb(11 11 10 / 0.75);
    border: 1px solid rgb(236 235 230 / 0.35);
    animation: hint 2.4s ease-in-out infinite;
  }
  .tv:not(.is-muted) .tv__tap span { display: none; }
  .tv.is-off .tv__tap span::before { content: '▶ '; }
  .tv__tap:hover span,
  .tv__tap:focus-visible span { background: var(--red); border-color: var(--red); color: var(--bg); animation: none; }
  @keyframes hint { 50% { border-color: var(--red); } }

  .tv__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--rule);
    border-top: 0;
    background: var(--bg-2);
    font: 500 0.72rem/1.3 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .tv__btn {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--dim);
    white-space: nowrap;
  }
  .tv__btn:hover,
  .tv__sound[aria-pressed='true'],
  .tv__drawer-btn[aria-expanded='true'] { color: var(--red); }
  .tv__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    margin: -0.6rem 0;
  }
  .tv__icon:first-child { margin-left: -0.5rem; }
  .tv__icon svg { width: 1.25rem; height: 1.25rem; }
  .tv__fs svg,
  .tv__fs-exit svg { width: 1.05rem; height: 1.05rem; }
  .tv__sound-on,
  .tv__sound[aria-pressed='true'] .tv__sound-off { display: none; }
  .tv__sound[aria-pressed='true'] .tv__sound-on { display: block; }
