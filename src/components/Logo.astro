---
// Pushit's mark: the boxed PUSHIT.TV wordmark over a CCTV dome with an eye.
// Redrawn from the Instagram avatar — swap in the original vector artwork when available.
interface Props {
  size?: 's' | 'l';
}
const { size = 's' } = Astro.props;
---

<span class:list={['logo-mark', `logo-mark--${size}`]}>
  <span class="logo-mark__word">PUSHIT.TV</span>
  <svg class="logo-mark__dome" viewBox="0 0 64 30" aria-hidden="true">
    <path d="M4 0 H60 A28 28 0 0 1 4 0 Z" fill="currentColor"></path>
    <circle cx="32" cy="13" r="8" fill="var(--bg)"></circle>
    <circle cx="32" cy="13" r="5" fill="currentColor"></circle>
    <circle cx="33.4" cy="14.2" r="3.1" fill="var(--bg)"></circle>
  </svg>
</span>

<style>
  .logo-mark {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    color: var(--fg);
    line-height: 1;
  }
  .logo-mark__word {
    font: 800 1.05em/1 'Montserrat', 'Arial Black', sans-serif;
    letter-spacing: 0.01em;
    background: var(--fg);
    color: var(--bg);
    padding: 0.2em 0.35em 0.16em;
    border-radius: 0.18em;
  }
  .logo-mark__dome {
    width: 2.6em;
    height: auto;
    margin-top: 0.12em;
    font-size: 1.05em;
  }
  .logo-mark--l .logo-mark__word { font-size: clamp(2rem, 7vw, 4rem); }
  .logo-mark--l .logo-mark__dome { font-size: clamp(2rem, 7vw, 4rem); }
</style>
