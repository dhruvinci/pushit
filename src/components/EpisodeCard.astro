---
import { SERIES, stamp, coverSrc, type NumberedEpisode } from '../lib/episodes';

interface Props {
  ep: NumberedEpisode;
  size?: 'l' | 'm';
}
const { ep, size = 'm' } = Astro.props;
---

<article class:list={['card', `card--${size}`]}>
  <a href={`/tapes/${ep.id}/`}>
    <div class="card__img">
      <img src={coverSrc(ep.data.cover)} alt="" loading="lazy" decoding="async" />
      <span class="card__tape">{ep.tape}</span>
    </div>
    <p class="kicker"><span class="stamp">{stamp(ep.data.date)}</span> {SERIES[ep.data.series].label}</p>
    <h3 class="display card__subject">{ep.data.subject}</h3>
    <p class="card__title">{ep.data.title}</p>
    <p class="card__where">{[ep.data.venue, ep.data.city].filter(Boolean).join(', ')}</p>
  </a>
</article>

<style>
  .card a { display: block; text-decoration: none; }
  .card a:hover { color: var(--fg); }
  .card__img {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-2);
    margin-bottom: 1rem;
  }
  .card--l .card__img { aspect-ratio: 16 / 10; }
  .card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15);
    transition: filter 0.25s, transform 0.5s;
  }
  .card a:hover .card__img img { filter: none; transform: scale(1.03); }
  .card__tape {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    font: 500 0.7rem/1 var(--mono);
    letter-spacing: 0.12em;
    background: var(--bg);
    padding: 0.4em 0.6em;
  }
  .card__subject {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    margin: 0.5rem 0 0.35rem;
  }
  .card--l .card__subject { font-size: clamp(2.4rem, 5vw, 4rem); }
  .card__title {
    font: italic 400 1.15rem/1.3 var(--serif);
    margin: 0 0 0.5rem;
  }
  .card a:hover .card__title { color: var(--red); }
  .card__where { font-size: 0.75rem; color: var(--dim); text-transform: uppercase; letter-spacing: 0.1em; margin: 0; }
</style>
