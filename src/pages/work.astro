---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';

const work = await Promise.all(
  (await getCollection('work')).map(async (w) => ({
    ...w,
    artist: await getEntry(w.data.artist),
  })),
);
---

<Base
  title="Work"
  image="/og/work.jpg"
  description="Music videos Pushit TV has made with Godless, Maneating Orchid and more."
>
  <section class="wrap page-head">
    <p class="rec">Commissions open</p>
    <h1 class="display display--xl">We make<br />music videos</h1>
    <p class="headline">
      For bands we love. Every idea on the table, and the only test for keeping it: does it work for the song?
    </p>
  </section>

  <section class="wrap">
    <ol class="work">
      {
        work.map((w, i) => (
          <li class="work__item">
            <div class="work__player">
              <YouTube id={w.data.youtube} title={`${w.artist.data.name} — ${w.data.title}`} />
            </div>
            <div class="work__info">
              <p class="kicker">
                <span class="stamp">{String(i + 1).padStart(2, '0')}</span> {w.data.kind} · {w.data.year}
              </p>
              <h2 class="display display--m">{w.data.title}</h2>
              <p class="work__artist">
                <a href={`/spotted/${w.artist.id}/`}>{w.artist.data.name}</a>
              </p>
              <dl class="credits">
                {w.data.credits.map((c) => (
                  <div>
                    <dt>{c.role}</dt>
                    <dd>{c.names}</dd>
                  </div>
                ))}
              </dl>
              {w.data.note && <p class="work__note">{w.data.note}</p>}
              {w.data.bts && (
                <a class="arrow-link" href={`/tapes/${w.data.bts.id}/`}>
                  Behind the scenes
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="contact" id="contact">
    <div class="wrap contact__inner">
      <div>
        <p class="kicker">Like what we're doing?</p>
        <h2 class="display display--l">Want to<br />pitch in?</h2>
      </div>
      <div class="contact__body">
        <p>
          Pushit is a community driven initiative. If you think you can contribute to this project in any way, shape or
          form, feel free to DM us on Instagram.
        </p>
        <a class="btn btn--red" href="https://ig.me/m/pushit.tv" rel="noopener">DM us on Instagram ↗</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(2rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem); }
  .page-head h1 { margin: 1rem 0 1.4rem; }
  .work { list-style: none; margin: 0; padding: 0; }
  .work__item {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--rule);
  }
  .work__item :global(.yt) { margin-bottom: 0; }
  .work__item :global(.yt__meta) { display: none; }
  .work__info h2 { margin: 0.8rem 0 0.4rem; }
  .work__artist { font: 400 1rem/1.3 var(--mono); margin: 0 0 1.5rem; }
  .credits { margin: 0 0 1.5rem; display: grid; gap: 0.7rem; }
  .credits dt { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); }
  .credits dd { margin: 0.2rem 0 0; }
  .work__note { color: var(--dim); font-size: 0.85rem; margin: 0 0 1.5rem; }

  .contact {
    margin-top: clamp(4rem, 8vw, 6rem);
    background: var(--red);
    color: var(--bg);
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .contact .kicker { color: var(--bg); }
  .contact h2 { margin-top: 0.6rem; }
  .contact__body > p { font: 400 1rem/1.6 var(--mono); margin: 0 0 1.8rem; max-width: 36ch; }
  .contact .btn--red { background: var(--bg); border-color: var(--bg); color: var(--fg); }
  .contact .btn--red:hover { background: var(--fg); border-color: var(--fg); color: var(--bg); }
    font: 400 1rem/1.4 var(--mono);
    padding: 0.75rem;
    background: var(--bg);
    color: var(--fg);
    border: 0;
    text-transform: none;
    letter-spacing: 0;
  }

  @media (max-width: 52rem) {
    .work__item,
    .contact__inner { grid-template-columns: 1fr; }
  }
</style>
